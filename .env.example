# ==================== RecWeb 项目环境配置模板 ====================
# 使用说明:
#   1. 复制此文件为 .env:  copy .env.example .env
#   2. 修改下方标记 [必需] 的配置项
#   3. 其余保持默认即可

# ==================== SASRec 推理服务 (services/sasrec_api) ====================
SASREC_HOST=0.0.0.0
SASREC_PORT=8200
# SASREC_MODEL_PATH=SASRec-Feb-24-2026_17-54-22.pth
# SASREC_CACHE_PATH=standard_cache.pkl
# SASREC_ITEM_FILE=electronics.item

# ==================== 多Agent推荐系统 (services/recommendation_agent) ====================
RECOMMENDATION_HOST=0.0.0.0
RECOMMENDATION_PORT=5001
SASREC_API_URL=http://127.0.0.1:8200

# [可选] 商品信息文件路径（默认自动定位到 shared/data/electronics.item）
# ITEM_FILE_PATH=/path/to/electronics.item

# [可选] DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== ShopWeb 网站 (services/shop_web) ====================
SHOPWEB_HOST=0.0.0.0
SHOPWEB_PORT=3000
# FE-05/Z-BE-02: 必须 False —— debug=True 会启用 Werkzeug 交互式 traceback,
# 向客户端暴露源码/栈/SQL/库名(对未捕获异常,如 context_processor 崩溃类)。
# run.py 默认已是 False,但 load_dotenv 会注入此 env,故必须在此显式置 False。
SHOPWEB_DEBUG=False
SECRET_KEY=dev-secret-key-change-in-production

# [必需] 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=shopify2
DB_CHARSET=utf8mb4

# ==================== Backend API (services/backend_api) ====================
BACKEND_API_URL=http://localhost:5000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# ==================== LLM Rerank Service (services/llm_rerank_service) ====================
RERANK_HOST=0.0.0.0
RERANK_PORT=5002
RERANK_DEBUG=True

# ==================== Review Service (services/review_service) ====================
REVIEW_SERVICE_URL=http://localhost:5003
REVIEW_SERVICE_HOST=0.0.0.0
REVIEW_SERVICE_PORT=5003

# ==================== Catalog Service (services/catalog_service) ====================
CATALOG_SERVICE_URL=http://localhost:5005
CATALOG_SERVICE_HOST=0.0.0.0
CATALOG_SERVICE_PORT=5005

# ==================== Cart Service (services/cart_service) ====================
CART_SERVICE_URL=http://localhost:5006
CART_SERVICE_HOST=0.0.0.0
CART_SERVICE_PORT=5006

# ==================== User Service (services/user_service) ====================
USER_SERVICE_URL=http://localhost:5004
USER_SERVICE_HOST=0.0.0.0
USER_SERVICE_PORT=5004

# ==================== Address Service (services/address_service) ====================
ADDRESS_SERVICE_URL=http://localhost:5007
ADDRESS_SERVICE_HOST=0.0.0.0
ADDRESS_SERVICE_PORT=5007

# ==================== AI Memory Service (services/ai_memory_service) ====================
AI_MEMORY_SERVICE_URL=http://localhost:5008
AI_MEMORY_SERVICE_HOST=0.0.0.0
AI_MEMORY_SERVICE_PORT=5008

# ==================== Announcement Service (services/announcement_service) ====================
ANNOUNCEMENT_SERVICE_URL=http://localhost:5009
ANNOUNCEMENT_SERVICE_HOST=0.0.0.0
ANNOUNCEMENT_SERVICE_PORT=5009

# ==================== Inventory Service (services/inventory_service) ====================
# 库存微服务:reserve 时深度调用 catalog_service 校验商品(下游 CATALOG_SERVICE_URL,见上方 Catalog Service)
INVENTORY_SERVICE_URL=http://localhost:5013
INVENTORY_SERVICE_HOST=0.0.0.0
INVENTORY_SERVICE_PORT=5013

# ==================== Pricing Service (services/pricing_service) ====================
# 定价微服务:GET /api/pricing/<id> 深度调用 catalog_service 取基价(下游 CATALOG_SERVICE_URL,见上方 Catalog Service)
# 自有表 price_rules(markup/tax_rate),算价 final=base*(1+markup)*(1+tax_rate)
PRICING_SERVICE_URL=http://localhost:5014
PRICING_SERVICE_HOST=0.0.0.0
PRICING_SERVICE_PORT=5014

# ==================== Promotion Service (services/promotion_service) ====================
# 促销/优惠券微服务:GET /api/promotions 列出 active 优惠 / POST /api/promotions/validate 校验券码
# 自有新表 promotions(code/discount/active/expires_at),独立服务无下游调用
PROMOTION_SERVICE_URL=http://localhost:5015
PROMOTION_SERVICE_HOST=0.0.0.0
PROMOTION_SERVICE_PORT=5015

# ==================== Payment Service (services/payment_service) ====================
# 交易域支付微服务:GET /api/payments/<order_no> 查支付记录 / POST /api/payments{order_no,amount} mock 收款
# 自有新表 payments(order_no/amount/status[pending/paid/refunded]/created_at),独立服务无下游调用
# (按 order_no 引用订单,但不调 order 服务,避免环依赖)
PAYMENT_SERVICE_URL=http://localhost:5012
PAYMENT_SERVICE_HOST=0.0.0.0
PAYMENT_SERVICE_PORT=5012

# ==================== Order Service (services/order_service) ====================
# 交易域订单读微服务:GET /api/orders?user_token= 订单列表 / GET /api/orders/<order_no> 订单详情(读为主,复用现有 orders/order_items 表)
# 深度链(可选):订单详情 ?enrich=1 时经 HTTP 调 catalog_service 补当前商品信息(order→catalog,下游 CATALOG_SERVICE_URL,见上方 Catalog Service)
# 不做写、不调 payment/inventory(避免复杂事务)
ORDER_SERVICE_URL=http://localhost:5010
ORDER_SERVICE_HOST=0.0.0.0
ORDER_SERVICE_PORT=5010

# ==================== Checkout Service (services/checkout_service) ====================
# 交易域结账编排微服务(纯编排,无表):GET /api/checkout/preview?user_token= 结账预览(只读不下单)
# ★★ 核心三路扇出(症状漂移源头):checkout→cart_service / checkout→pricing_service / checkout→inventory_service
# 下游均经 get_service_url 解析(Nacos 优先,回退下方 *_SERVICE_URL),见上方 Cart / Pricing / Inventory Service
CHECKOUT_SERVICE_URL=http://localhost:5011
CHECKOUT_SERVICE_HOST=0.0.0.0
CHECKOUT_SERVICE_PORT=5011

# ==================== Interaction Service (services/interaction_service) ====================
# 支撑域行为埋点写中枢:POST /api/interactions 写一条交互(view/click/purchase/add_to_cart) / GET /api/interactions?user_token= 读最近交互
# 复用现有 interactions 表,无下游调用;高 fan-in 写中枢(各端打点经此)
INTERACTION_SERVICE_URL=http://localhost:5020
INTERACTION_SERVICE_HOST=0.0.0.0
INTERACTION_SERVICE_PORT=5020

# ==================== Merchant Service (services/merchant_service) ====================
# 支撑域商家资料微服务:GET /api/merchants/<id> 商家资料+其店铺 / POST /api/merchants/<id> 部分更新资料+店铺(单事务)
# 复用现有 merchants/shops 表,独立服务无下游调用;shop_web 商家端"商家资料/店铺管理"写路径经此代理(保留 @merchant_required + 归属)
MERCHANT_SERVICE_URL=http://localhost:5019
MERCHANT_SERVICE_HOST=0.0.0.0
MERCHANT_SERVICE_PORT=5019

# ==================== Admin Audit Service (services/admin_audit_service) ====================
# 支撑域管理操作审计微服务:POST /api/audit 写一条审计 / GET /api/audit?limit= 读最近审计
# 复用现有 admin_logs 表,无下游调用;shop_web 管理端 AdminLog.log() 写路径经此代理(保留管理端鉴权,下游不可用降级本地 ORM)
ADMIN_AUDIT_SERVICE_URL=http://localhost:5022
ADMIN_AUDIT_SERVICE_HOST=0.0.0.0
ADMIN_AUDIT_SERVICE_PORT=5022

# ==================== Notification Service (services/notification_service) ====================
# 支撑域通知微服务(叶子,无下游调用):POST /api/notifications 写一条异步通知 / GET /api/notifications?user_token= 列出该用户通知
# 自有新表 notifications(user_token/type/title/content/is_read/created_at);后续被 order/payment/shipping 异步 fan-in
# shop_web 不接(纯新增异步节点)
NOTIFICATION_SERVICE_URL=http://localhost:5021
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=5021

# ==================== Review Query Service (services/review_query_service) ====================
# 支撑域评论读微服务:GET /api/reviews?item_id=&status=approved&page= 商品评论列表 / GET /api/reviews/summary?item_id= 评论数+均分
# 复用现有 reviews/review_replies 表(与 review_service 写者配对,只读),shop_web "评论读路径"(GET /api/reviews/<item_id>)经此代理,下游不可用降级本地 ORM
# 深度链(可选):列表 ?enrich=1 时经 HTTP 调 catalog_service 补商品名/评分(下游 CATALOG_SERVICE_URL,见上方 Catalog Service)
REVIEW_QUERY_SERVICE_URL=http://localhost:5018
REVIEW_QUERY_SERVICE_HOST=0.0.0.0
REVIEW_QUERY_SERVICE_PORT=5018

# ==================== Search Service (services/search_service) ====================
# 支撑域搜索微服务:GET /api/search?q=&page=&per_page= 按标题/关键字检索在售商品(独立读模型,直查 items 表 LIKE title/brand/category),返回匹配列表+总数
# shop_web 买家端 /api/search(JSON)经此代理,补上"搜索经服务"这条边;search_service 不可用时 shop_web 降级本地 ORM 直查
# 深度链(可选):?enrich=1 时对首条结果经 HTTP 调 catalog_service 补单品详情(下游 CATALOG_SERVICE_URL,见上方 Catalog Service),下游不可用优雅降级
SEARCH_SERVICE_URL=http://localhost:5017
SEARCH_SERVICE_HOST=0.0.0.0
SEARCH_SERVICE_PORT=5017

# ==================== Shipping Service (services/shipping_service) ====================
# 支撑域发货微服务:POST /api/shipments{order_no,(可选)carrier} 建发货单(单事务) / GET /api/shipments/<order_no> 查该订单发货单
# 自有新表 shipments(order_no/carrier/tracking_no/status[pending|shipped|delivered]/created_at,幂等 CREATE TABLE IF NOT EXISTS)
# shop_web 商家端"发货"(merchant /api/orders/<no>/ship)在置 order=shipped 后事后 best-effort 代理本服务建发货单(不阻断原发货)
# 深度链尾(可选):建发货单后 best-effort 调 notification_service 异步通知(下游 NOTIFICATION_SERVICE_URL,见上方 Notification Service),下游不可用优雅降级
SHIPPING_SERVICE_URL=http://localhost:5016
SHIPPING_SERVICE_HOST=0.0.0.0
SHIPPING_SERVICE_PORT=5016

# Nacos 配置
NACOS_ENABLED=true
NACOS_SERVER_ADDRESSES=127.0.0.1:8848
NACOS_NAMESPACE=public
NACOS_GROUP=RECWEB2
