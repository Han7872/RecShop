# strict51 冻结身份链：这些文件的磁盘字节参与 SHA256 身份校验（freeze report
# source_sha256 / contract artifact）。仓库 core.autocrlf=true 会在 checkout 时把
# CRLF smudge 进文本文件，历史上一度造成合并后身份断链（须手工 git cat-file blob
# 裸写恢复）。此处钉 eol=lf：repo 内归一为 LF、checkout 恒出 LF，任何机器
# clone/checkout/reset 后身份链不再依赖手工恢复。
# （ps1 为 Docker 4.82 typed 探针补丁后版本，与 freeze 记录的补丁前哈希差异属
#   已披露合法差异，钉 LF 同样适用。）
scripts/chaos/ctk/chaos_k8s_runner.py eol=lf
scripts/chaos/ctk/run-traditional-v2-lite.ps1 eol=lf
scripts/chaos/ctk/traditional_v2_lite/b1_lite.py eol=lf
